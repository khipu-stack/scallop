---
import RawLayout from '../../layouts/RawLayout.astro';

// 这行神奇的代码会自动找到当前文件夹下所有的 .md 文章
const allNotes = await Astro.glob('./*.md');

const sortedNotes = allNotes.sort((a, b) => {
  return new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf();
});

// 让文章按发布顺序倒序排列（如果有日期的话），这里暂时不排序，直接列出
---

<RawLayout title="notes // SCALLOP">
  <h1>notes</h1>
  
  <p>archived: {allNotes.length}</p>

  <ul class="note-list">
    {sortedNotes.map((note) => (
      <li>
        <a href={note.url}>{note.frontmatter.title}</a>
      </li>
    ))}
  </ul>

</RawLayout>

<style>
  .note-list {
    list-style: none; /* 去掉默认的小圆点 */
    padding: 0;
    margin-top: 40px;
    border: none;
  }

  .note-list li {
    margin-bottom: 15px;
    padding-bottom: 5px;
    border: none;
  }
</style>