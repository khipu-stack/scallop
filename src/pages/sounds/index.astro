---
import RawLayout from '../../layouts/RawLayout.astro';

type SoundItem = {
  title: string;
  year?: number;
  date?: string;
  summary?: string;
  readMore?: string;
  external?: string;
  embedSrc?: string;
  embedHeight?: number;
  iaIdentifier?: string;
  order?: number;
  _url?: string;
};

const all = await Astro.glob('./*.md');

const items: SoundItem[] = all
  .map((m): SoundItem => {
    const fm = (m.frontmatter ?? {}) as Partial<SoundItem>;

    const year =
      fm.year ??
      (fm.date ? Number(String(fm.date).slice(0, 4)) : undefined);

    return {
      ...fm,
      year,
      _url: m.url,
    } as SoundItem;
  })
  .sort((a, b) => {
    const ay = a.year ?? 0;
    const by = b.year ?? 0;
    if (ay !== by) return by - ay;

    const ao = a.order ?? 9999;
    const bo = b.order ?? 9999;
    if (ao !== bo) return ao - bo;

    return (a.title ?? '').localeCompare(b.title ?? '');
  });

const isExternal = (u?: string) => typeof u === 'string' && /^https?:\/\//.test(u);
---


<RawLayout title="sounds // SCALLOP">
  <p class="muted">updating...</p>

  <div class="sound-list">
    {items.map((it) => {
      // 标题点击：优先去 readMore（站内 notes），否则如果有 external 就去 external，否则去该 md 自己的页面
      const titleUrl = it.readMore ?? it.external ?? it._url ?? '#';
      const titleExternal = isExternal(titleUrl);

      // 小三角展开的 embed：优先 embedSrc；如果没写但写了 iaIdentifier，也能工作
      const embedUrl =
        it.embedSrc ??
        (it.iaIdentifier ? `https://archive.org/embed/${it.iaIdentifier}` : null);

      const height = it.embedHeight ?? 140;

      return (
        <section class="sound-entry">
          <header class="sound-head">
            <h3 class="sound-title">
              <a
                href={titleUrl}
                target={titleExternal ? '_blank' : undefined}
                rel={titleExternal ? 'noreferrer' : undefined}
              >
                {it.title}
              </a>
            </h3>
            {it.year ? <div class="sound-year">{it.year}</div> : null}
          </header>

          {it.summary ? <p class="sound-summary">{it.summary}</p> : null}

          {embedUrl ? (
            <details class="sound-player">
              <summary aria-label="preview">▶</summary>

              <div class="player-wrap">
                <iframe
                  width="100%"
                  height={height}
                  scrolling="no"
                  frameborder="0"
                  src={embedUrl}
                  allow="autoplay; encrypted-media; fullscreen"
                ></iframe>
              </div>

              {it.external ? (
                <div class="external">
                  <a href={it.external} target="_blank" rel="noreferrer">
                    Open
                  </a>
                </div>
              ) : null}
            </details>
          ) : null}
        </section>
      );
    })}
  </div>
</RawLayout>

<style>
  :global(main) {
    max-width: 760px;
  }

  .sound-list {
    margin-top: 18px;
  }

  .sound-entry {
    padding: 18px 0;
    border-bottom: 1px solid color-mix(in srgb, currentColor 12%, transparent);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .sound-entry h3,
  .sound-entry p,
  .sound-entry details {
    margin: 0;
  }

  .sound-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    row-gap: 4px;
  }

  .sound-title {
    font-size: 1.1rem;
    line-height: 1.25;
  }

  .sound-title a {
    color: var(--accent);
    text-decoration: none;
  }

  .sound-title a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .sound-year {
    font-size: 0.85rem;
    opacity: 0.6;
    white-space: nowrap;
  }

  .sound-summary {
    line-height: 1.55;
    opacity: 0.85;
    max-width: 68ch;
  }

  .sound-player summary {
    cursor: pointer;
    user-select: none;
    color: var(--accent);
    width: fit-content;
    line-height: 1.2;
    padding: 0;
    list-style: none;
  }

  .sound-player summary::-webkit-details-marker {
    display: none;
  }
  .sound-player summary::marker {
    content: '';
  }

  .sound-player[open] summary {
    transform: rotate(90deg);
    transform-origin: left center;
  }

  .sound-player summary:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--accent) 35%, transparent);
    outline-offset: 6px;
    border-radius: 8px;
  }

  .player-wrap {
    margin-top: 10px;
    border: 1px solid color-mix(in srgb, currentColor 14%, transparent);
    border-radius: 10px;
    overflow: hidden;
    background: color-mix(in srgb, currentColor 3%, transparent);
  }

  .external {
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px solid color-mix(in srgb, currentColor 12%, transparent);
    font-size: 0.9rem;
    opacity: 0.7;
  }

  .external a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
