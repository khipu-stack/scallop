---
import RawLayout from '../../layouts/RawLayout.astro';

const allDebris = await Astro.glob('./*.md');

const sortedDebris = allDebris.sort((a, b) => {
  const ao = a.frontmatter.order ?? 9999;
  const bo = b.frontmatter.order ?? 9999;
  if (ao !== bo) return ao - bo;
  return a.file.localeCompare(b.file);
});
---

<RawLayout title="debris // SCALLOP">
  <h1>debris</h1>
  <p class="muted">fragments, leftovers, misreads.</p>

  {sortedDebris.length === 0 ? (
    <div class="panel muted">empty for now.</div>
  ) : (
    <ul class="debris-list">
      {sortedDebris.map((item) => (
        <li>
          <a class="debris-item" href={item.url}>
            <div class="topline">
              <span class="title">{item.frontmatter.title}</span>
              {item.frontmatter.source ? (
                <span class="source">{item.frontmatter.source}</span>
              ) : null}
            </div>

            {item.frontmatter.summary ? (
              <p class="summary">{item.frontmatter.summary}</p>
            ) : null}

            {Array.isArray(item.frontmatter.tags) ? (
              <div class="tags" aria-label="tags">
                {item.frontmatter.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            ) : null}
          </a>
        </li>
      ))}
    </ul>
  )}
</RawLayout>

<style>
  /* 让内容不要铺满超宽屏：这一步对“阅读舒适”非常关键 */
  .debris-list {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    max-width: 760px;
  }

  .debris-list li {
    margin: 0;
  }

  /* 整行可点：减少“点哪里”的认知负担 */
  .debris-item {
    display: block;
    padding: 14px 0 16px;
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid color-mix(in srgb, currentColor 12%, transparent);
  }

  .topline {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  /* 标题：维持你站点的“蓝色主线”，但不需要霓虹 */
  .title {
    font-size: 1.1rem;
    line-height: 1.3;
    color: var(--accent, #1f5bff);
    text-decoration: none;
  }

  /* source：弱化为元信息，不抢 */
  .source {
    font-size: 0.85rem;
    opacity: 0.55;
    white-space: nowrap;
  }

  /* 摘要：正文可读的灰度 */
  .summary {
    margin: 8px 0 0;
    line-height: 1.55;
    opacity: 0.82;
    max-width: 68ch; /* 让段落读起来更稳 */
  }

  /* tags：保留，但做成“低噪音” */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }

  .tag {
    font-size: 0.78rem;
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, currentColor 14%, transparent);
    opacity: 0.7;
  }

  /* hover / focus：只做轻微提示（不改变整个配色体系） */
  .debris-item:hover .title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .debris-item:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--accent, #1f5bff) 35%, transparent);
    outline-offset: 6px;
    border-radius: 8px;
  }

  @media (prefers-reduced-motion: reduce) {
    .debris-item {
      transition: none;
    }
  }
</style>
