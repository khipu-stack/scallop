---
import RawLayout from '../../layouts/RawLayout.astro';

const allLatent = await Astro.glob('./*.md');

const sortedLatent = allLatent.sort((a, b) => {
  const ao = a.frontmatter.order ?? 9999;
  const bo = b.frontmatter.order ?? 9999;
  if (ao !== bo) return ao - bo;
  return a.file.localeCompare(b.file);
});
---

<RawLayout title="latent // SCALLOP">
  <h1>latent</h1>
  <p class="muted">seeds, sketches, unfinished notes.</p>

  {sortedLatent.length === 0 ? (
    <div class="panel muted">empty for now.</div>
  ) : (
    <div class="latent-stack">
      {sortedLatent.map((item) => (
        <article class="latent-card">
          <div class="latent-top">
            <span class="pulse"></span>
            <a href={item.url} class="title">{item.frontmatter.title}</a>
          </div>
          {item.frontmatter.seed ? (
            <p class="seed">seed: {item.frontmatter.seed}</p>
          ) : null}
          <div class="meta-row">
            {item.frontmatter.medium ? (
              <span class="meta">medium: {item.frontmatter.medium}</span>
            ) : null}
            {item.frontmatter.status ? (
              <span class="meta">status: {item.frontmatter.status}</span>
            ) : null}
          </div>
          {Array.isArray(item.frontmatter.tags) ? (
            <div class="tags">
              {item.frontmatter.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          ) : null}
        </article>
      ))}
    </div>
  )}
</RawLayout>

<style>
  .latent-stack {
    display: grid;
    gap: 16px;
    margin-top: 26px;
    position: relative;
  }

  .latent-stack::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 20% 10%, rgba(255,255,255,0.03), transparent 45%),
      radial-gradient(circle at 80% 30%, rgba(255,255,255,0.025), transparent 50%),
      linear-gradient(180deg, rgba(255,255,255,0.02), rgba(0,0,0,0.02));
    opacity: 0.8;
    pointer-events: none;
    z-index: 0;
  }

  .latent-card {
    border: 1px solid #1a1a1a;
    padding: 16px;
    background: linear-gradient(180deg, #121212, #0b0b0b);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.02);
    position: relative;
    z-index: 1;
  }

  .latent-top {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .pulse {
    width: 10px;
    height: 10px;
    background: #00ff41;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(0, 255, 65, 0.6);
    animation: pulse 2.2s infinite;
  }

  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(0, 255, 65, 0.6); }
    70% { box-shadow: 0 0 0 12px rgba(0, 255, 65, 0); }
    100% { box-shadow: 0 0 0 0 rgba(0, 255, 65, 0); }
  }

  .title {
    border-bottom: none;
    font-weight: 700;
  }

  .seed {
    color: #9a9a9a;
    margin-top: 10px;
  }

  .meta-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  .meta {
    font-size: 0.8em;
    color: #808080;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
  }

  .tag {
    font-size: 0.7em;
    border: 1px solid #333;
    padding: 2px 6px;
    color: #8a8a8a;
  }

  /* paper theme adjustments */
  :global(html[data-theme="paper"]) .latent-stack::before {
    background: radial-gradient(circle at 20% 10%, rgba(0,0,0,0.03), transparent 45%),
      radial-gradient(circle at 80% 30%, rgba(0,0,0,0.025), transparent 50%),
      linear-gradient(180deg, rgba(0,0,0,0.02), rgba(255,255,255,0.02));
    opacity: 0.9;
  }

  :global(html[data-theme="paper"]) .latent-card {
    border: 1px solid #d2cdc3;
    background: linear-gradient(180deg, #f2ede3, #e9e3d9);
    box-shadow: inset 0 0 0 1px rgba(0,0,0,0.03);
  }

  :global(html[data-theme="paper"]) .seed {
    color: #333;
  }

  :global(html[data-theme="paper"]) .meta {
    color: #4b4b4b;
  }

  :global(html[data-theme="paper"]) .tag {
    border-color: #bdb6aa;
    color: #4b4b4b;
  }
</style>
