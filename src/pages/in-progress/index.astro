---
import RawLayout from '../../layouts/RawLayout.astro';

const allProgress = await Astro.glob('./*.md');

const sortedProgress = allProgress.sort((a, b) => {
  const ao = a.frontmatter.order ?? 9999;
  const bo = b.frontmatter.order ?? 9999;
  if (ao !== bo) return ao - bo;
  return a.file.localeCompare(b.file);
});
---

<RawLayout title="in progress // SCALLOP">
  <h1>in progress</h1>
  <p class="muted">what I'm currently building / editing / compiling.</p>

  {sortedProgress.length === 0 ? (
    <div class="panel muted">empty for now.</div>
  ) : (
    <ul class="progress-list">
      {sortedProgress.map((item) => (
        <li>
          <a class="progress-entry" href={item.url}>
            <div class="topline">
              <span class="title">{item.frontmatter.title}</span>
              {item.frontmatter.status ? (
                <span class="status">{item.frontmatter.status}</span>
              ) : null}
            </div>
            {item.frontmatter.focus ? (
              <p class="meta">↳ {item.frontmatter.focus}</p>
            ) : null}
            {item.frontmatter.next ? (
              <p class="meta">→ {item.frontmatter.next}</p>
            ) : null}
          </a>
        </li>
      ))}
    </ul>
  )}
</RawLayout>

<style>
  .progress-list {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    max-width: 760px;
  }

  .progress-list li {
    margin: 0;
  }

  .progress-entry {
    display: block;
    padding: 14px 0 16px;
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid color-mix(in srgb, currentColor 12%, transparent);
  }

  .topline {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  .title {
    font-size: 1.1rem;
    line-height: 1.3;
    color: var(--accent);
  }

  .status {
    font-size: 0.82rem;
    opacity: 0.55;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .meta {
    margin: 6px 0 0;
    font-size: 0.88rem;
    line-height: 1.55;
    opacity: 0.72;
    max-width: 68ch;
  }

  .progress-entry:hover .title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .progress-entry:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--accent) 35%, transparent);
    outline-offset: 6px;
    border-radius: 8px;
  }
</style>
