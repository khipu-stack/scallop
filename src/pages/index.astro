<style is:global>
  .container-home .site-header {
    position: relative;
  }

  .container-home .nav.nav-primary {
    position: relative;
    z-index: 30;
  }

  .container-home .wordmark.glitchmark {
    font-family: "FungalVF", sans-serif;
    text-transform: none;
    display: inline-flex;
    flex-wrap: nowrap;
    align-items: flex-end;
    overflow: visible;
    font-size: clamp(6rem, 15vw, 13rem);
    line-height: 0.82;
    letter-spacing: -0.095em;
    margin: 0 0 0.04em 0;
    padding: 0.03em 0 0;
    isolation: isolate;
    width: max-content;
    position: relative;
    z-index: 10;
  }

  .container-home .wordmark.glitchmark .glyph {
    display: inline-block;
    overflow: visible;
    transform-origin: center 72%;
    will-change: font-variation-settings, transform, filter;
    font-variation-settings: 'THCK' 600, 'grow' 260;

    --mut-dur: 2.95s;
    --mut-delay: 0s;
    --jitter-dur: 620ms;
    --jitter-delay: 0s;

    animation:
      fungal-mutant-outer var(--mut-dur) steps(1, end) infinite var(--mut-delay),
      fungal-jitter-outer var(--jitter-dur) steps(2, end) infinite var(--jitter-delay);

    /* Let nav links under transformed glyph overflow stay clickable */
    pointer-events: none;
  }

  .container-home .wordmark.glitchmark .char-s {
    --mut-delay: -0.11s;
    --jitter-delay: -0.37s;
    --mut-dur: 3.05s;
  }
  .container-home .wordmark.glitchmark .char-c {
    --mut-delay: -0.86s;
    --jitter-delay: -0.12s;
    --mut-dur: 2.78s;
  }

  .container-home .wordmark.glitchmark .char-a,
  .container-home .wordmark.glitchmark .char-l1,
  .container-home .wordmark.glitchmark .char-l2 {
    --mut-dur: 1.85s;
    --jitter-dur: 360ms;
  }

  .container-home .wordmark.glitchmark .char-a {
    --mut-delay: -1.29s;
    --jitter-delay: -0.2s;
  }

  .container-home .wordmark.glitchmark .char-l1 {
    --mut-delay: -0.48s;
    --jitter-delay: -0.08s;
  }

  .container-home .wordmark.glitchmark .char-l2 {
    --mut-delay: -1.57s;
    --jitter-delay: -0.31s;
  }

  .container-home .wordmark.glitchmark .char-o {
    --mut-delay: -0.74s;
    --jitter-delay: -0.41s;
    --mut-dur: 2.82s;
  }

  .container-home .wordmark.glitchmark .char-p {
    --mut-delay: -1.93s;
    --jitter-delay: -0.22s;
    --mut-dur: 3.1s;
  }

  .container-home .wordmark.glitchmark .infected {
    color: color-mix(in srgb, var(--accent) 86%, var(--fg) 14%);
    filter: contrast(1.08);
    animation-name: fungal-mutant-infected, fungal-jitter-infected;
  }

  @keyframes fungal-mutant-outer {
    0% {
      font-variation-settings: 'THCK' 560, 'grow' 220;
      transform: translate3d(0, 0, 0) scaleX(1) scaleY(1);
    }
    12% {
      font-variation-settings: 'THCK' 760, 'grow' 520;
      transform: translate3d(-0.012em, 0.014em, 0) scaleX(0.97) scaleY(1.07);
    }
    24% {
      font-variation-settings: 'THCK' 540, 'grow' 860;
      transform: translate3d(0.016em, -0.011em, 0) scaleX(1.07) scaleY(0.93);
    }
    41% {
      font-variation-settings: 'THCK' 840, 'grow' 430;
      transform: translate3d(-0.016em, 0.008em, 0) scaleX(0.94) scaleY(1.1);
    }
    57% {
      font-variation-settings: 'THCK' 640, 'grow' 740;
      transform: translate3d(0.012em, -0.015em, 0) scaleX(1.05) scaleY(0.96);
    }
    76% {
      font-variation-settings: 'THCK' 860, 'grow' 610;
      transform: translate3d(-0.015em, 0.009em, 0) scaleX(0.94) scaleY(1.08);
    }
    100% {
      font-variation-settings: 'THCK' 600, 'grow' 240;
      transform: translate3d(0, 0, 0) scaleX(1) scaleY(1);
    }
  }

  @keyframes fungal-mutant-infected {
    0% {
      font-variation-settings: 'THCK' 420, 'grow' 380;
      transform: translate3d(0, 0, 0) scaleX(1.03) scaleY(1);
    }
    9% {
      font-variation-settings: 'THCK' 980, 'grow' 990;
      transform: translate3d(-0.03em, 0.03em, 0) scaleX(0.86) scaleY(1.24);
    }
    19% {
      font-variation-settings: 'THCK' 360, 'grow' 1260;
      transform: translate3d(0.032em, -0.022em, 0) scaleX(1.22) scaleY(0.76);
    }
    28% {
      font-variation-settings: 'THCK' 1100, 'grow' 640;
      transform: translate3d(-0.028em, 0.02em, 0) scaleX(0.82) scaleY(1.3);
    }
    39% {
      font-variation-settings: 'THCK' 480, 'grow' 1300;
      transform: translate3d(0.035em, -0.03em, 0) scaleX(1.26) scaleY(0.72);
    }
    53% {
      font-variation-settings: 'THCK' 1200, 'grow' 760;
      transform: translate3d(-0.033em, 0.025em, 0) scaleX(0.8) scaleY(1.35);
    }
    66% {
      font-variation-settings: 'THCK' 540, 'grow' 1320;
      transform: translate3d(0.028em, -0.032em, 0) scaleX(1.2) scaleY(0.74);
    }
    81% {
      font-variation-settings: 'THCK' 1080, 'grow' 820;
      transform: translate3d(-0.024em, 0.02em, 0) scaleX(0.87) scaleY(1.23);
    }
    100% {
      font-variation-settings: 'THCK' 620, 'grow' 460;
      transform: translate3d(0, 0, 0) scaleX(1.04) scaleY(0.98);
    }
  }

  @keyframes fungal-jitter-outer {
    0%, 100% { transform: translate3d(0, 0, 0); }
    25% { transform: translate3d(0.004em, -0.006em, 0); }
    50% { transform: translate3d(-0.006em, 0.005em, 0); }
    75% { transform: translate3d(0.003em, 0.004em, 0); }
  }

  @keyframes fungal-jitter-infected {
    0%, 100% { transform: translate3d(0, 0, 0) scaleX(1); }
    20% { transform: translate3d(0.014em, -0.014em, 0) scaleX(1.04); }
    40% { transform: translate3d(-0.016em, 0.012em, 0) scaleX(0.95); }
    60% { transform: translate3d(0.01em, 0.016em, 0) scaleX(1.08); }
    80% { transform: translate3d(-0.012em, -0.01em, 0) scaleX(0.92); }
  }

  .container-home .wordmark.glitchmark:hover .glyph {
    animation-duration: calc(var(--mut-dur) * 0.74), calc(var(--jitter-dur) * 0.7);
    filter: contrast(1.14) saturate(1.08);
  }

  .container-home .wordmark.glitchmark:hover .infected {
    filter: contrast(1.25) saturate(1.18);
  }

  @media (prefers-reduced-motion: reduce) {
    .container-home .wordmark.glitchmark .glyph {
      animation: none;
      transform: none;
      font-variation-settings: 'THCK' 680, 'grow' 420;
      filter: none;
    }

    .container-home .wordmark.glitchmark .infected {
      font-variation-settings: 'THCK' 760, 'grow' 520;
      transform: none;
    }
  }
</style>
