---
import RawLayout from '../layouts/RawLayout.astro';

// [关键代码 1] 抓取逻辑：告诉 Astro 去 works 文件夹里找所有的 .md 文件
// 注意：因为 works.astro 在 pages 根目录，所以路径是 './works/*.md'
const allWorks = await Astro.glob('./works/*.md');

// [关键代码 2] 排序逻辑：按日期倒序（最新的在前面）
allWorks.sort((a, b) => Date.parse(b.frontmatter.date) - Date.parse(a.frontmatter.date));
---

<RawLayout title="works // SCALLOP">
  <p class="muted">more coming...</p>

  {allWorks.length === 0 ? (
    <ul>
      <li class="muted">no entries yet.</li>
    </ul>
  ) : (
    <div class="grid-container">
      {allWorks.map((work) => (
        <a href={work.url} class="work-card">
          <div class="thumb-container">
            <img src={work.frontmatter.thumbnail} alt={work.frontmatter.title} />
          </div>
          
          <div class="info">
            <span class="type">[{work.frontmatter.type}]</span>
            <h3>{work.frontmatter.title}</h3>
            <p class="desc">{work.frontmatter.description}</p>
          </div>
        </a>
      ))}
    </div>
  )}

</RawLayout>

<style>
  .muted {
    color: var(--muted);
    font-size: 0.9em;
  }

  /* 网格布局系统 */
  .grid-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 30px;
    margin-top: 16px;
  }

  .work-card {
    display: block;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--fg) 6%, var(--bg));
    text-decoration: none;
    transition: all 0.2s;
  }

  .work-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 2px 2px 0 var(--accent);
  }

  .thumb-container {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }

  .thumb-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: filter 0.3s;
    margin: 0;
    border: none;
  }

  .work-card:hover img {
    filter: grayscale(0%);
  }

  .info {
    padding: 15px;
  }

  .type {
    font-size: 0.7em;
    color: var(--muted);
    font-family: monospace;
    display: block;
    margin-bottom: 5px;
  }

  .work-card h3 {
    margin: 0 0 10px 0;
    font-size: 1.1em;
    color: var(--fg);
    border: none;
  }

  .work-card:hover h3 {
    color: var(--accent);
  }

  .desc {
    font-size: 0.85em;
    color: var(--muted);
    line-height: 1.4;
    margin: 0;
    /* 限制显示3行，超出省略 */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>