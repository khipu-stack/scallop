---
const { title = "" } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <style>
      /* 不要再写 :root / body 的裸选择器 */
      body.bare {
        background: #fff;
        color: #111;
        margin: 0;
        padding: clamp(16px, 4vw, 56px);
        font: 16px/1.55 system-ui, -apple-system, Segoe UI, Roboto, "Noto Sans", Arial, sans-serif;
      }
      body.bare main { max-width: 72ch; }
      body.bare h1 { font-size: 1.6rem; line-height: 1.2; margin: 0 0 1rem 0; }
      body.bare p { margin: 0 0 1rem 0; }
      body.bare a { text-underline-offset: .2em; }
      body.bare img { max-width: 100%; height: auto; display: block; margin: 1rem 0; }
    </style>
  </head>

  <body class="bare">
    <main>
      <slot />
    </main>
  </body>
</html>