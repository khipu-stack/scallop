---
// src/layouts/RawLayout.astro
const { title = "SCALLOP" } = Astro.props;

const year = new Date().getFullYear();
const pathname = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(href + "/");
};
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content="slowly growing construction // works / sound / notes" />
  </head>

  <body id="TOP">
  <div class="container">
    <header class="site-header">
      <div class="mast">
        <a class="wordmark" href="/">SCALLOP</a>
        <div class="muted">slowly growing construction</div>
      </div>

      <nav class="nav nav-primary" aria-label="Primary">
        <a href="/">home</a>
        <a href="/works">works</a>
        <a href="/music">sound</a>
        <a href="/notes">notes</a>
      </nav>

      <nav class="nav nav-secondary" aria-label="Status">
        <a href="/in-progress">in progress</a>
        <a href="/latent">latent</a>
        <a href="/debris">debris</a>
      </nav>
    </header>

    <main><slot /></main>

      <footer>
        &copy; {year} SCALLOP // slowly growing construction
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root{
    --bg: #050505;
    --fg: #d4d4d4;
    --muted: #888;
    --border: #333;
    --accent: #00ff41;
    --panel: #0e0e0e;
  }

  * { box-sizing: border-box; }

  body {
    background-color: var(--bg);
    color: var(--fg);
    font-family: 'Courier New', Courier, monospace, "PingFang SC";
    margin: 0;
    padding: 20px;
    font-size: 16px;
    line-height: 1.55;
    letter-spacing: 0.02em;
  }

  h1, h2, h3, h4, h5, h6, strong, b {
    color: var(--accent);
    font-weight: bold;
  }

  h1, h2, h3 {
    border-bottom: 2px solid var(--accent);
    padding-bottom: 10px;
    margin-top: 40px;
    margin-bottom: 20px;
  }

  a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    transition: all 0.15s;
  }

  a:hover {
    background-color: var(--accent);
    color: #000;
  }
  
  .container {
    max-width: 750px;
    margin: 0 auto;
    border: 1px solid var(--border);
    border-top: 4px solid var(--accent);
    padding: 40px;
    min-height: 90vh;
  }

  .site-header{
    margin-bottom: 50px;
  }

  .nav{
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .nav.secondary{
    margin-top: 10px;
    opacity: 0.9;
  }

  /* 让链接像“路标”而不是“菜单项” */
  .nav a::before { content: "[ "; }
  .nav a::after { content: " ]"; }

  /* 当前页面的路标：更亮一点，但不做花哨高亮 */
  .nav a[aria-current="page"]{
    border-bottom: 2px solid var(--accent);
  }

  .muted{ color: var(--muted); }

  .panel{
    background: transparent;
    border: 1px solid var(--border);
    padding: 12px 14px;
    margin: 20px 0;
  }

  blockquote {
    background: transparent;
    border-left: 4px solid var(--accent);
    margin: 30px 0;
    padding-left: 20px;
    color: var(--muted);
    font-style: italic;
  }

  code {
    background-color: #111;
    color: var(--accent);
    padding: 2px 6px;
    border-radius: 2px;
    font-family: monospace;
  }

  pre {
    background-color: #111;
    padding: 15px;
    border: 1px dashed var(--border);
    overflow-x: auto;
  }

  main img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 30px auto;
    border: 1px solid var(--border);
  }

  footer {
    margin-top: 50px;
    border-top: 1px dashed var(--border);
    padding-top: 10px;
    font-size: 0.8em;
    color: #666;
  }
</style>
