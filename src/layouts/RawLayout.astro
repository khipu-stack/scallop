---
// src/layouts/RawLayout.astro
const {
  title = "SCALLOP",
  theme = "dark", // dark | paper
} = Astro.props;

const year = new Date().getFullYear();
const pathname = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(href + "/");
};

// 小工具：返回 aria-current 值（不 active 就不给属性）
const currentIfActive = (href: string) => (isActive(href) ? "page" : undefined);
---

<html lang="zh-CN" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content="slowly growing construction // works / sound / notes" />
  </head>

  <body id="TOP">
    <div class="container">
      <header class="site-header">
        <div class="mast">
          <a class="wordmark" href="/" aria-current={currentIfActive("/")}>SCALLOP</a>
          <div class="muted">slowly growing construction</div>
        </div>

        <nav class="nav nav-primary" aria-label="Primary">
          <a href="/" aria-current={currentIfActive("/")}>home</a>
          <a href="/works" aria-current={currentIfActive("/works")}>works</a>
          <a href="/music" aria-current={currentIfActive("/music")}>sound</a>
          <a href="/notes" aria-current={currentIfActive("/notes")}>notes</a>
        </nav>

        <nav class="nav nav-secondary" aria-label="Status">
          <a href="/in-progress" aria-current={currentIfActive("/in-progress")}>in progress</a>
          <a href="/latent" aria-current={currentIfActive("/latent")}>latent</a>
          <a href="/debris" aria-current={currentIfActive("/debris")}>debris</a>
        </nav>
      </header>

      <main><slot /></main>

      <footer>
        &copy; {year} SCALLOP // slowly growing construction
      </footer>
    </div>
  </body>
</html>

<style is:global>
  /* -----------------------------
    0) Theme tokens
    默认 dark
  ----------------------------- */
  :root{
    --bg: #050505;
    --fg: #d4d4d4;
    --muted: #888;

    --border: #333;
    --accent: #00ff41;

    --panel: transparent;

    --code-bg: #111;
    --code-fg: var(--accent);

    --container-w: 750px;
    --container-pad: 40px;

    --font-body: 'Courier New', Courier, monospace, "PingFang SC";
    --font-size: 16px;
    --line-height: 1.55;
    --letter-spacing: 0.02em;
  }

  /* paper 主题 */
  html[data-theme="paper"]{
    --bg: #f6f3ea;     /* 微暖纸色 */
    --fg: #111;
    --muted: #555;

    --border: #bbb;
    --accent: #1a49ff; /* 蓝色标题 */

    --panel: transparent;

    --code-bg: #eee;
    --code-fg: #111;
  }

  * { box-sizing: border-box; }

  body {
    background-color: var(--bg);
    color: var(--fg);
    font-family: var(--font-body);
    margin: 0;
    padding: 20px;
    font-size: var(--font-size);
    line-height: var(--line-height);
    letter-spacing: var(--letter-spacing);
  }

  /* -----------------------------
    1) Typography
  ----------------------------- */
  h1, h2, h3, h4, h5, h6, strong, b {
    color: var(--accent);
    font-weight: bold;
  }

  h1, h2, h3 {
    border-bottom: 2px solid var(--accent);
    padding-bottom: 10px;
    margin-top: 40px;
    margin-bottom: 20px;
  }

  .muted{ color: var(--muted); }

  /* -----------------------------
    2) Links
  ----------------------------- */
  a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    transition: all 0.15s;
  }

  a:hover {
    background-color: var(--accent);
    color: var(--bg); /* ✅ 不写死 #000，让 paper 也成立 */
  }

  /* -----------------------------
    3) Layout container
  ----------------------------- */
  .container {
    max-width: var(--container-w);
    margin: 0 auto;
    border: 1px solid var(--border);
    border-top: 4px solid var(--accent);
    padding: var(--container-pad);
    min-height: 90vh;
    background: var(--panel);
  }

  .site-header{
    margin-bottom: 50px;
  }

  .mast{
    margin-bottom: 0 px;
  }

  .wordmark{
    border-bottom: none; 
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .wordmark:hover{
    background: transparent;
    color: var(--accent);
  }  

  /* -----------------------------
    4) Navigation
  ----------------------------- */
  .nav{
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .nav-secondary{
    margin-top: 0px;
    opacity: 0.9;
  }

  .nav a::before { content: "[ "; }
  .nav a::after { content: " ]"; }

  .nav a[aria-current="page"]{
    border-bottom: none;
  }

  /* -----------------------------
    5) Panels / blocks
  ----------------------------- */
  .panel{
    background: transparent;
    border: 1px solid var(--border);
    padding: 12px 14px;
    margin: 20px 0;
  }

  blockquote {
    background: transparent;
    border-left: 4px solid var(--accent);
    margin: 30px 0;
    padding-left: 20px;
    color: var(--muted);
    font-style: italic;
  }

  /* -----------------------------
    6) Code
  ----------------------------- */
  code {
    background-color: var(--code-bg);
    color: var(--code-fg);
    padding: 2px 6px;
    border-radius: 2px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
  }

  pre {
    background-color: var(--code-bg);
    padding: 15px;
    border: 1px dashed var(--border);
    overflow-x: auto;
  }

  /* -----------------------------
    7) Media
  ----------------------------- */
  main img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 30px auto;
    border: 1px solid var(--border);
  }

  /* -----------------------------
    8) Footer
  ----------------------------- */
  footer {
    margin-top: 50px;
    border-top: 1px dashed var(--border);
    padding-top: 10px;
    font-size: 0.8em;
    color: var(--muted);
  }
</style>
