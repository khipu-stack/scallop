---
// src/layouts/RawLayout.astro
const {
  title = "SCALLOP",
  theme = "paper", // dark | paper
} = Astro.props;

const year = new Date().getFullYear();
const pathname = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(href + "/");
};

const currentIfActive = (href: string) => (isActive(href) ? "page" : undefined);
---

<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content="slowly growing construction // works / sound / notes" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap"
    rel="stylesheet"
    />
    <script is:inline>
      const saved = localStorage.getItem("theme");
      const sys = window.matchMedia("(prefers-color-scheme: dark)").matches;
      const theme = saved || (sys ? "dark" : "paper");
      document.documentElement.setAttribute("data-theme", theme);
    </script>
  </head>

  <body id="TOP">
    <div class="container">
      <header class="site-header">
        <div class="mast">
          <div>
            <a class="wordmark" href="/" aria-current={currentIfActive("/")}>SCALLOP</a>
            <div class="muted">slowly growing construction</div>
          </div>
          <button id="theme-toggle" type="button" aria-label="Toggle theme">◐</button>
        </div>

        <nav class="nav nav-primary" aria-label="Primary">
          <a href="/" aria-current={currentIfActive("/")}>home</a>
          <a href="/works" aria-current={currentIfActive("/works")}>works</a>
          <a href="/music" aria-current={currentIfActive("/music")}>sounds</a>
          <a href="/notes" aria-current={currentIfActive("/notes")}>notes</a>
        </nav>

        <nav class="nav nav-secondary" aria-label="Status">
          <a href="/in-progress" aria-current={currentIfActive("/in-progress")}>in progress</a>
          <a href="/latent" aria-current={currentIfActive("/latent")}>latent</a>
          <a href="/debris" aria-current={currentIfActive("/debris")}>debris</a>
        </nav>
      </header>

      <main><slot /></main>

      <!--
      <footer>
        &copy; {year} SCALLOP // slowly growing construction
      </footer>
      -->
    </div>
    <script is:inline>
      const btn = document.getElementById("theme-toggle");
      if (btn) {
        btn.addEventListener("click", () => {
          const doc = document.documentElement;
          const current = doc.getAttribute("data-theme");
          const next = current === "paper" ? "dark" : "paper";
          doc.setAttribute("data-theme", next);
          localStorage.setItem("theme", next);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  /* -----------------------------
    0) Theme tokens
    默认 dark
  ----------------------------- */
  :root{
    --bg: #050505;
    --fg: #d4d4d4;
    --muted: #888;

    --border: #333;
    --accent: #00ff41;

    --panel: transparent;

    --code-bg: #111;
    --code-fg: var(--accent);

    --container-w: 88ch; /*750px;*/
    --container-pad: clamp(20px, 4vw, 52px);/*40px;*/

    /* --font-body: 'Courier New', Courier, monospace, "PingFang SC"; */
    --font-body: "Space Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace, "PingFang SC";
    --font-size: 16px;
    --line-height: 1.55;
    --letter-spacing: 0em;
  }

  /* paper 主题 */
  html[data-theme="paper"]{
    --bg: #f6f3ea;     /* 微暖纸色 */
    --fg: #111;
    --muted: #555;

    --border: #bbb;
    --accent: #1a49ff; /* 蓝色标题 */

    --panel: transparent;

    --code-bg: #e9e4da;
    --code-fg: #111;
  }

  * { box-sizing: border-box; }

  body {
    background-color: var(--bg);
    color: var(--fg);
    font-family: var(--font-body);
    margin: 0;
    padding: 20px;
    font-size: var(--font-size);
    line-height: var(--line-height);
    letter-spacing: var(--letter-spacing);
    text-align: left;
  }

  /* -----------------------------
    1) Typography
  ----------------------------- */
  h1, h2, h3, h4, h5, h6, strong, b {
    color: var(--accent);
    font-weight: bold;
  }

  h1, h2, h3 {
    /* border-bottom: 2px solid var(--accent); */
    padding-bottom: 10px;
    margin-top: 40px;
    margin-bottom: 20px;
  }

  .muted{ color: var(--muted); }

  /* -----------------------------
    2) Links
  ----------------------------- */
  a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    transition: all 0.15s;
  }

  a:hover {
    background-color: var(--accent);
    color: var(--bg); 
  }

  /* -----------------------------
    2.5) Code blocks
  ----------------------------- */
  pre, code {
    background: var(--code-bg);
    color: var(--code-fg);
  }

  pre {
    padding: 14px;
    border: 1px solid var(--border);
    overflow: auto;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.2),
      inset 0 0 20px rgba(0,0,0,0.03);
  }

  code {
    padding: 2px 4px;
  }

  /* -----------------------------
    3) Layout container
  ----------------------------- */
  .container {
    max-width: var(--container-w);
    margin: 0 auto;
    border: none; /* 1px solid var(--border); */
    border-top: 4px solid var(--accent);
    padding: var(--container-pad);
    padding-top: 11px;
    min-height: 90vh;
    background: var(--panel);
  }

  .site-header{
    padding-bottom: 24px;
    /*border-bottom: 1px solid sandybrown var(--border)*/
    margin-bottom: 36px; /*50 before*/
    font-size: 0.8em; /* Scale down header text */
  }

  .mast{
    margin-bottom: 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .wordmark{
    border-bottom: none; 
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .wordmark:hover{
    background: transparent;
    color: var(--accent);
  }  

  /* -----------------------------
    4) Navigation
  ----------------------------- */
  .nav{
    display: flex;
    flex-wrap: nowrap;
    gap: 12px;
    overflow-x: auto;        
    -webkit-overflow-scrolling: touch; 
    scrollbar-width: none;
  }

  .nav::-webkit-scrollbar {
    display: none;
  }

  .nav-secondary{
    margin-top: 0px;
    opacity: 0.9;
  }

  .nav a::before { content: "[ "; }
  .nav a::after { content: " ]"; }

  .nav a[aria-current="page"]{
    border-bottom: none;
  }

  /* -----------------------------
    5) Panels / blocks
  ----------------------------- */
  .panel{
    background: transparent;
    border: 1px solid var(--border);
    padding: 12px 14px;
    margin: 20px 0;
  }

  blockquote {
    background: transparent;
    border-left: 4px solid var(--accent);
    margin: 30px 0;
    padding-left: 20px;
    color: var(--muted);
    font-style: italic;
  }

/* -----------------------------
    6) Code
  ----------------------------- */
  
  /* A. Inline Code*/
  :not(pre) > code {
    background: var(--code-bg);
    color: var(--accent); 
    padding: 0.1em 0.4em;
    border-radius: 3px;
    font-family: var(--font-body);
    font-size: 0.9em;
    border: 1px solid transparent; 
  }

  /* B. Pre Block */
  pre {
    background: #111; /* var(--code-bg) */
    
    padding: 20px;
    border: 1px solid var(--border);
    
    border-left: 4px solid var(--border); 
    
    border-radius: 4px;
    overflow-x: auto;
    
    line-height: 1.6;
    font-size: 0.9em; 
    tab-size: 2;
  }

  /* for Paper Theme */
  html[data-theme="paper"] pre {
    background: #fcfcfc;
    border-color: #ccc;
    border-left-color: var(--accent);
  }

  /* C. Code inside Pre */
  pre code {
    background: transparent;
    padding: 0;
    border: none;
    border-radius: 0;
    font-family: var(--font-body); 
    color: inherit; 
    display: inline-block; 
    min-width: 100%;
  }

  /* D. Webkit Scroll */
  pre::-webkit-scrollbar {
    height: 8px; 
  }
  
  pre::-webkit-scrollbar-track {
    background: var(--bg);
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
  }
  
  pre::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 4px;
    cursor: pointer;
  }
  
  pre::-webkit-scrollbar-thumb:hover {
    background: var(--muted);
  }

  /* -----------------------------
    7) Media
  ----------------------------- */
  main img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 30px auto;
    border: 1px solid var(--border);
  }

  /* 视频容器响应式优化 (16:9) */
  .video-container {
    width: 100%;
    aspect-ratio: 16 / 9;
    margin: 30px 0;
    background: #000;
  }
  .video-container iframe {
    width: 100%;
    height: 100%;
  }

  /* -----------------------------
    8) Footer
  ----------------------------- */
  footer {
    margin-top: 50px;
    border-top: 1px dashed var(--border);
    padding-top: 10px;
    font-size: 0.8em;
    color: var(--muted);
  }

  /* -----------------------------
    9) Content Alignment
  ----------------------------- */
  main p {
    text-align: left; /* justify or left */
    
    overflow-wrap: break-word; 

    letter-spacing: -0.01em; 
  }

  main li {
    text-align: left; 
  }

  /* -----------------------------
    10) Theme Toggle
  ----------------------------- */
  #theme-toggle {
    background: transparent;
    border: none;
    color: var(--muted);
    font-family: inherit;
    font-size: 1.2em; /* Slightly larger for the symbol */
    cursor: pointer;
    padding: 0;
    line-height: 1;
    transition: all 0.15s;
  }
  #theme-toggle:hover {
    color: var(--accent);
    transform: rotate(15deg); /* playful interaction */
  }

</style>
