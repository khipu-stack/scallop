---
// src/layouts/RawLayout.astro
const {
  title = "SCALLOP",
  theme = "paper", // dark | paper
  layoutVariant = "default", // default | home
} = Astro.props;

const year = new Date().getFullYear();
const pathname = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(href + "/");
};

const currentIfActive = (href: string) => (isActive(href) ? "page" : undefined);
const homeWordmarkChars = [
  { char: "s", cls: "char-s" },
  { char: "c", cls: "char-c" },
  { char: "a", cls: "char-a infected" },
  { char: "l", cls: "char-l1 infected" },
  { char: "l", cls: "char-l2 infected" },
  { char: "o", cls: "char-o" },
  { char: "p", cls: "char-p" },
];
---

<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content="slowly growing construction // works / sound / notes" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap"
    rel="stylesheet"
    />
    <script is:inline>
      const saved = localStorage.getItem("theme");
      const sys = window.matchMedia("(prefers-color-scheme: dark)").matches;
      const theme = saved || (sys ? "dark" : "paper");
      document.documentElement.setAttribute("data-theme", theme);
    </script>
  </head>

  <body id="TOP">
    <div class={`container ${layoutVariant === "home" ? "container-home" : ""}`}>
      <header class="site-header">
        <div class="mast">
          <div>
            <a
              class={`wordmark ${layoutVariant === "home" ? "glitchmark" : ""}`}
              href="/"
              aria-current={currentIfActive("/")}
              aria-label={layoutVariant === "home" ? "scallop" : undefined}
            >
              {layoutVariant === "home"
                ? homeWordmarkChars.map((entry, i) => (
                    <span class={`glyph ${entry.cls}`} style={`--char-i:${i}`}>{entry.char}</span>
                  ))
                : "SCALLOP"}
            </a>
            {/* <div class="muted">slowly growing construction</div> */}
          </div>
          <button id="theme-toggle" type="button" aria-label="Toggle theme">◐</button>
        </div>

        <nav class="nav nav-primary" aria-label="Primary">
          <a href="/" aria-current={currentIfActive("/")}>~</a>
          <a href="/works" aria-current={currentIfActive("/works")}>works</a>
          <a href="/sounds" aria-current={currentIfActive("/sounds")}>sounds</a>
          <a href="/notes" aria-current={currentIfActive("/notes")}>notes</a>
        </nav>
      </header>

      <main><slot /></main>

      <!--
      <footer>
        &copy; {year} SCALLOP // slowly growing construction
      </footer>
      -->
    </div>
    <script is:inline>
      const btn = document.getElementById("theme-toggle");
      if (btn) {
        btn.addEventListener("click", () => {
          const doc = document.documentElement;
          const current = doc.getAttribute("data-theme");
          const next = current === "paper" ? "dark" : "paper";
          doc.setAttribute("data-theme", next);
          localStorage.setItem("theme", next);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  /* -----------------------------
    Fungal variable font
  ----------------------------- */
  @font-face {
    font-family: "FungalVF";
    src: url("/fonts/fungal/FungalVF.woff2") format("woff2");
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  /* -----------------------------
    0) Theme tokens
    默认 dark
  ----------------------------- */
  :root{
    --bg: #050505;
    --fg: #d4d4d4;
    --muted: #888;

    --border: #333;
    --accent: #00ff41;

    --panel: transparent;

    --code-bg: #22272e;
    /* --code-fg: var(--accent); */
    --code-border: color-mix(in srgb, currentColor 14%, transparent);

    --container-w: 88ch; /*750px;*/
    --container-pad: clamp(20px, 4vw, 52px);/*40px;*/

    /* --font-body: 'Courier New', Courier, monospace, "PingFang SC"; */
    --font-body: "Space Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace, "PingFang SC";
    --font-size: 16px;
    --line-height: 1.55;
    --letter-spacing: 0em;
  }

  /* paper 主题 */
  html[data-theme="paper"]{
    --bg: #f6f3ea;     /* 微暖纸色 */
    --fg: #111;
    --muted: #555;

    --border: #bbb;
    --accent: #1a49ff; /* 蓝色标题 */

    --panel: transparent;

    --code-bg: #fafaf8;
    /* --code-fg: #111; */
    --code-border: color-mix(in srgb, currentColor 16%, transparent);
  }

  * { box-sizing: border-box; }

  body {
    background-color: var(--bg);
    color: var(--fg);
    font-family: var(--font-body);
    margin: 0;
    padding: 20px;
    font-size: var(--font-size);
    line-height: var(--line-height);
    letter-spacing: var(--letter-spacing);
    text-align: left;
  }

  /* -----------------------------
    1) Typography
  ----------------------------- */
  h1, h2, h3, h4, h5, h6, strong, b {
    color: var(--accent);
    font-weight: bold;
  }

  h1 {
    border-bottom: 2px solid var(--accent);
  }

  h1, h2, h3 {
    /* border-bottom: 2px solid var(--accent); */
    padding-bottom: 10px;
    margin-top: 40px;
    margin-bottom: 20px;
  }

  .muted{ color: var(--muted); }

  /* -----------------------------
    2) Links
  ----------------------------- */
  a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    transition: all 0.15s;
  }

  a:hover {
    background-color: var(--accent);
    color: var(--bg); 
  }

  /* -----------------------------
    2.5) Code blocks
  
  pre, code {
    background: var(--code-bg);
    color: var(--code-fg);
  }

  pre {
    padding: 14px;
    border: 1px solid var(--border);
    overflow: auto;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.2),
      inset 0 0 20px rgba(0,0,0,0.03);
  }

  code {
    padding: 2px 4px;
  }
  ----------------------------- */

  /* -----------------------------
    3) Layout container
  ----------------------------- */
  .container {
    max-width: var(--container-w);
    margin: 0 auto;
    border: none; /* 1px solid var(--border); */
    /* border-top: 4px solid var(--accent); */
    padding: var(--container-pad);
    padding-top: 11px;
    min-height: 90vh;
    background: var(--panel);
  }

  .container-home {
    max-width: min(1200px, 92vw);
  }

  .site-header{
    padding-bottom: 24px;
    /*border-bottom: 1px solid sandybrown var(--border)*/
    margin-bottom: 36px; /*50 before*/
    font-size: 0.8em; /* Scale down header text */
  }

  .mast{
    margin-bottom: 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .wordmark{
    border-bottom: none; 
    font-weight: 700;
    letter-spacing: 0.04em;
    font-size: clamp(1.45rem, 1.1rem + 0.65vw, 2rem);
    line-height: 1;
    display: inline-flex;
    align-items: baseline;
    gap: 0.01em;
    text-transform: uppercase;
  }
  .wordmark:hover{
    background: transparent;
    color: var(--accent);
  }

  /* Inner-page wordmark: site label, not a competing title */
  .container:not(.container-home) .wordmark {
    font-size: clamp(1.1rem, 0.85rem + 0.45vw, 1.5rem);
    color: var(--muted);
    font-weight: 400;
  }

  /* Inner pages: left-align container so content starts at the same edge as homepage */
  .container:not(.container-home) {
    margin-left: 0;
  }

  /* -----------------------------
    4) Navigation
  ----------------------------- */
  .nav{
    display: flex;
    flex-wrap: nowrap;
    gap: 12px;
    overflow-x: auto;        
    -webkit-overflow-scrolling: touch; 
    scrollbar-width: none;
  }

  .nav::-webkit-scrollbar {
    display: none;
  }

  .nav a::before { content: "[ "; }
  .nav a::after { content: " ]"; }

  .nav a[aria-current="page"]{
    border-bottom: none;
  }

  /* -----------------------------
    5) Panels / blocks
  ----------------------------- */
  .panel{
    background: transparent;
    border: 1px solid var(--border);
    padding: 12px 14px;
    margin: 20px 0;
  }

  blockquote {
    background: transparent;
    border-left: 4px solid var(--accent);
    margin: 30px 0;
    padding-left: 20px;
    color: var(--muted);
    font-style: italic;
  }

  /* -----------------------------
    6) Code (Shiki-friendly)
  ----------------------------- */

  :not(pre) > code{
  background: color-mix(in srgb, currentColor 6%, transparent);
  border: 1px solid color-mix(in srgb, currentColor 12%, transparent);
  border-radius: 6px;
  padding: 0.12em 0.38em;
  font-family: var(--font-body);
  font-size: 0.9em;
  }
/*
  pre{
  background-color: var(--code-bg);
  border: 1px solid var(--code-border);
  border-radius: 12px;
  padding: 18px 20px;
  margin: 16px 0;
  overflow-x: auto;
  line-height: 1.6;
  font-size: 0.92em;
  tab-size: 2;
  }

  pre.astro-code{
  background-color: var(--code-bg) !important;
  border-left: 4px solid color-mix(in srgb, var(--accent) 60%, transparent);
  }

  pre code{
  background: transparent !important;
  border: 0 !important;
  padding: 0 !important;
  }
*/

  /* Shiki code blocks */
  pre.astro-code{
    background-color: var(--code-bg) !important; /* 覆盖 Shiki inline bg（#fff / #24292e） */
    border: 1px solid var(--code-border);
    border-left: 4px solid color-mix(in srgb, var(--accent) 60%, transparent);
    border-radius: 12px;

    padding: 18px 20px;
    margin: 16px 0;

    overflow-x: auto;
    line-height: 1.6;
    font-size: 0.92em;
    tab-size: 2;
  }

  /* 不要让 code 自己再画背景 */
  pre.astro-code code{
    background: transparent !important;
    padding: 0 !important;
    border: 0 !important;
  }  

  /*
  html[data-theme="paper"] pre.astro-code span[style*="--shiki-light"]{
    color: var(--shiki-light) !important;
  }
  html[data-theme="dark"] pre.astro-code span[style*="--shiki-dark"]{
    color: var(--shiki-dark) !important;
  }
  */



  /* Scrollbar */
  pre::-webkit-scrollbar{ height: 8px; }
  pre::-webkit-scrollbar-track{
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
  }
  pre::-webkit-scrollbar-thumb{
    background: color-mix(in srgb, currentColor 18%, transparent);
    border-radius: 12px;
  }
  pre::-webkit-scrollbar-thumb:hover{
    background: color-mix(in srgb, currentColor 28%, transparent);
  }


  /* -----------------------------
    7) Media
  ----------------------------- */
  main img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 30px auto;
    border: 1px solid var(--border);
  }

  /* 视频容器响应式优化 (16:9) */
  .video-container {
    width: 100%;
    aspect-ratio: 16 / 9;
    margin: 30px 0;
    background: #000;
  }
  .video-container iframe {
    width: 100%;
    height: 100%;
  }

  /* -----------------------------
    8) Footer
  ----------------------------- */
  footer {
    margin-top: 50px;
    border-top: 1px dashed var(--border);
    padding-top: 10px;
    font-size: 0.8em;
    color: var(--muted);
  }

  /* -----------------------------
    9) Content Alignment
  ----------------------------- */
  main p {
    text-align: left; /* justify or left */
    
    overflow-wrap: break-word; 

    letter-spacing: -0.01em; 
  }

  main li {
    text-align: left; 
  }

  /* -----------------------------
    10) Theme Toggle
  ----------------------------- */
  #theme-toggle {
    background: transparent;
    border: none;
    color: var(--muted);
    font-family: inherit;
    font-size: 1.2em; /* Slightly larger for the symbol */
    cursor: pointer;
    padding: 0;
    line-height: 1;
    transition: all 0.15s;
  }
  #theme-toggle:hover {
    color: var(--accent);
    transform: rotate(15deg); /* playful interaction */
  }

</style>
