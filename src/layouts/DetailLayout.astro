---
// src/layouts/DetailLayout.astro
// Used by individual detail pages (works, etc.).
// Replaces the full site header with a minimal ← section back link.
const {
  title = "SCALLOP",
  theme = "paper",
} = Astro.props;

// Derive parent section from URL: /works/molar-security → works
const segment = Astro.url.pathname.split("/").filter(Boolean)[0] ?? "";
const backHref = segment ? `/${segment}` : "/";
const backLabel = segment || "home";
---

<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content="slowly growing construction // works / sound / notes" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      const saved = localStorage.getItem("theme");
      const sys = window.matchMedia("(prefers-color-scheme: dark)").matches;
      const theme = saved || (sys ? "dark" : "paper");
      document.documentElement.setAttribute("data-theme", theme);
    </script>
  </head>

  <body id="TOP" class="detail">
    <div class="container">
      <div class="detail-top">
        <nav class="detail-nav" aria-label="Back">
          <a href={backHref}>← {backLabel}</a>
        </nav>
        <button id="theme-toggle" type="button" aria-label="Toggle theme">◐</button>
      </div>

      <main><slot /></main>
    </div>

    <script is:inline>
      const btn = document.getElementById("theme-toggle");
      if (btn) {
        btn.addEventListener("click", () => {
          const doc = document.documentElement;
          const current = doc.getAttribute("data-theme");
          const next = current === "paper" ? "dark" : "paper";
          doc.setAttribute("data-theme", next);
          localStorage.setItem("theme", next);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  /* -----------------------------
    Diatype variable font
    Available only on pages that load DetailLayout.
  ----------------------------- */
  @font-face {
    font-family: "DiatypeVF";
    src: url("/fonts/diatype/ABCDiatypeVariable.woff2") format("woff2");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  /* -----------------------------
    Theme tokens (shared, safe — additive only)
    --font-reading and --font-mono are new variables;
    --font-body is NOT redefined here so RawLayout pages
    are not affected if styles are merged.
  ----------------------------- */
  :root {
    --bg: #050505;
    --fg: #d4d4d4;
    --muted: #888;
    --border: #333;
    --accent: #00ff41;
    --panel: transparent;
    --code-bg: #22272e;
    --code-border: color-mix(in srgb, currentColor 14%, transparent);
    --container-w: 88ch;
    --container-pad: clamp(20px, 4vw, 52px);
    --font-reading: "DiatypeVF", "Helvetica Neue", Arial, sans-serif;
    --font-mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, Monaco,
      Consolas, "Liberation Mono", "Courier New", monospace;
  }

  html[data-theme="paper"] {
    --bg: #f6f3ea;
    --fg: #111;
    --muted: #555;
    --border: #bbb;
    --accent: #1a49ff;
    --panel: transparent;
    --code-bg: #fafaf8;
    --code-border: color-mix(in srgb, currentColor 16%, transparent);
  }

  * { box-sizing: border-box; }

  /* Base body — inherited by all. Keeps Space Mono as default
     so RawLayout pages are unaffected even if this rule fires. */
  body {
    background-color: var(--bg);
    color: var(--fg);
    font-family: var(--font-mono);
    margin: 0;
    padding: 20px;
    font-size: 16px;
    line-height: 1.55;
    letter-spacing: 0;
    text-align: left;
  }

  /* -------------------------------------------------------
    All detail-specific typography is gated on body.detail.
    This class is only present in DetailLayout, so none of
    these rules can fire on the works index or any other page.
  ------------------------------------------------------- */

  body.detail {
    font-family: var(--font-reading);
    font-size: 17px;
    line-height: 1.76;
    letter-spacing: 0.005em;
  }

  /* Title: editorial, large, neutral — no rule beneath */
  body.detail h1 {
    font-family: var(--font-reading);
    font-weight: 500;
    font-size: clamp(1.75rem, 1.25rem + 2vw, 2.6rem);
    color: var(--fg);
    border-bottom: none;
    letter-spacing: -0.03em;
    line-height: 1.1;
    padding-bottom: 0;
    margin-top: 4px;
    margin-bottom: 36px;
  }

  /* Section headings: clearly below h1, clearly above body */
  body.detail h2 {
    font-family: var(--font-reading);
    font-weight: 480;
    font-size: 1.3rem;
    color: var(--fg);
    letter-spacing: -0.015em;
    padding-bottom: 0;
    margin-top: 52px;
    margin-bottom: 14px;
  }

  /* h3: clear subsection — size and weight lift it above body */
  body.detail h3 {
    font-family: var(--font-reading);
    font-weight: 520;
    font-size: 1.22rem;
    color: var(--fg);
    letter-spacing: -0.012em;
    padding-bottom: 0;
    margin-top: 40px;
    margin-bottom: 8px;
  }

  /* h4: archival label register — Space Mono, muted, wide tracking */
  body.detail h4,
  body.detail h5,
  body.detail h6 {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.78rem;
    color: var(--muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-top: 28px;
    margin-bottom: 6px;
  }

  /* Bold inline: weight shift only, inherits surrounding color */
  body.detail strong,
  body.detail b {
    font-weight: 600;
    color: inherit;
  }

  /* Blockquote: archival / citation register — Space Mono, not italic */
  body.detail blockquote {
    background: transparent;
    border-left: 2px solid var(--border);
    margin: 40px 0;
    padding: 2px 0 2px 20px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 0.83em;
    line-height: 1.62;
  }

  /* Body paragraphs: measure-constrained for reading */
  body.detail main p {
    text-align: left;
    overflow-wrap: break-word;
    max-width: 72ch;
  }

  body.detail main li {
    text-align: left;
    max-width: 72ch;
  }

  /* Code stays on mono inside detail pages */
  body.detail :not(pre) > code {
    background: color-mix(in srgb, currentColor 6%, transparent);
    border: 1px solid color-mix(in srgb, currentColor 12%, transparent);
    border-radius: 6px;
    padding: 0.12em 0.38em;
    font-family: var(--font-mono);
    font-size: 0.84em;
  }

  body.detail pre.astro-code {
    font-family: var(--font-mono);
    font-size: 0.88em;
  }

  /* -------------------------------------------------------
    Layout / structural rules — safe to be unscoped since
    these class names only exist in DetailLayout markup.
  ------------------------------------------------------- */

  .container {
    max-width: var(--container-w);
    margin-left: 0;
    margin-right: auto;
    padding: var(--container-pad);
    padding-top: 11px;
    min-height: 90vh;
    background: var(--panel);
  }

  /* Top bar: explicitly mono, stays independent of body font */
  .detail-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 36px;
    font-size: 0.82em;
    font-family: var(--font-mono);
  }

  .detail-nav a {
    color: var(--muted);
    border-bottom: none;
    letter-spacing: 0.04em;
  }

  .detail-nav a:hover {
    color: var(--accent);
    background: transparent;
  }

  .panel {
    background: transparent;
    border: 1px solid var(--border);
    padding: 12px 14px;
    margin: 20px 0;
  }

  .muted { color: var(--muted); }

  /* Links retain accent — navigational emphasis */
  a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    transition: all 0.15s;
  }

  a:hover {
    background-color: var(--accent);
    color: var(--bg);
  }

  pre.astro-code {
    background-color: var(--code-bg) !important;
    border: 1px solid var(--code-border);
    border-left: 4px solid color-mix(in srgb, var(--accent) 60%, transparent);
    border-radius: 12px;
    padding: 18px 20px;
    margin: 16px 0;
    overflow-x: auto;
    font-family: var(--font-mono);
    line-height: 1.6;
    font-size: 0.92em;
    tab-size: 2;
  }

  pre.astro-code code {
    background: transparent !important;
    padding: 0 !important;
    border: 0 !important;
  }

  pre::-webkit-scrollbar { height: 8px; }
  pre::-webkit-scrollbar-track {
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
  }
  pre::-webkit-scrollbar-thumb {
    background: color-mix(in srgb, currentColor 18%, transparent);
    border-radius: 12px;
  }
  pre::-webkit-scrollbar-thumb:hover {
    background: color-mix(in srgb, currentColor 28%, transparent);
  }

  main img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 30px auto;
    border: 1px solid var(--border);
  }

  .video-container {
    width: 100%;
    aspect-ratio: 16 / 9;
    margin: 30px 0;
    background: #000;
  }
  .video-container iframe {
    width: 100%;
    height: 100%;
  }

  #theme-toggle {
    background: transparent;
    border: none;
    color: var(--muted);
    font-family: inherit;
    font-size: 1.2em;
    cursor: pointer;
    padding: 0;
    line-height: 1;
    transition: all 0.15s;
  }
  #theme-toggle:hover {
    color: var(--accent);
    transform: rotate(15deg);
  }
</style>
